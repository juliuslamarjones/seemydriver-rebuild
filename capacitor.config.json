{
  "appId": "com.seemydriver.app",
  "appName": "SeeMyDriver",
  "webDir": "www",
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#000000",
      "showSpinner": false
    }
  },
  "assets": {
    "android": {
      "icon": "assets/icon.png",
      "splash": "assets/splash.png",
      "splashBackgroundColor": "#000000"
    }
  }
}